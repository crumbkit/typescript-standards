{
  "name": "snippetshelf",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "format": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "fix": "biome check --write .",
    "typecheck": "tsc",
    "knip": "knip",
    "test": "vitest run",
    "build": "vite build",
    "bundle": "test -z \"$(git status --porcelain --untracked-files=all --ignored -- dist | tee /dev/stderr)\"",
    "size": "size-limit",
    "acceptance": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "size-limit": "14.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "size-limit": [
    {
      "name": "first load",
      "path": [
        "dist/index.html",
        "dist/assets/app.js",
        "dist/assets/index.css"
      ],
      "limit": "150 kB"
    },
    {
      "name": "every file",
      "path": [
        "dist/**/*"
      ],
      "limit": "250 kB"
    }
  ]
}
